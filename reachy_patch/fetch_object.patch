+    def fetch_object(self, body: dict[str, Any]) -> dict[str, Any]:
+        """Bring a household object (not a medicine) via the arm PC. Same confirm-first rule as dispense."""
+        name = str(body.get("object") or "").strip()
+        if not name:
+            return {"error": "Which object should I bring?", "speak_hint": "Ask which object they want."}
+        confirmed = bool(body.get("confirmed", False))
+        remote = HttpArmClient.from_config(self.config)
+        if remote is None:
+            return {
+                "error": "arm not connected",
+                "speak_hint": "I can't reach the arm computer right now. Please ask someone to check it.",
+            }
+        with self._lock:
+            key = f"fetch:{name.lower()}"
+            if confirmed and self.guard.enabled and not self.guard.has_pending(key):
+                confirmed = False  # the AI didn't ask first: ask now instead of acting
+            if confirmed:
+                blocked = self.guard.require_yes("fetch", key)
+                if blocked:
+                    return blocked
+            if not confirmed:
+                self.guard.ask(key)
+                return {
+                    "status": "needs_confirm",
+                    "object": name,
+                    "speak_hint": (
+                        f"Should I bring you the {name}? "
+                        "If they say yes, call fetch_object again with confirmed=true."
+                    ),
+                }
+            try:
+                result = remote.fetch(object_name=name)
+            except RuntimeError as exc:
+                return {
+                    "status": "error",
+                    "error": str(exc),
+                    "speak_hint": "I can't reach the arm computer right now.",
+                }
+        if result.ok and result.final_state == "placed":
+            demo = self.config.dry_run
+            hint = (
+                f"Demo mode: I found the {name} but the arm did not move."
+                if demo
+                else f"The {name} is ready for you."
+            )
+        else:
+            hint = f"Sorry, I could not bring the {name}. {result.error or result.detect_detail}".strip()
+        return {
+            "status": "ok" if result.ok else "failed",
+            "final_state": result.final_state,
+            "object": name,
+            "label": result.label,
+            "demo_mode": self.config.dry_run,
+            "detail": result.detect_detail,
+            "speak_hint": hint,
+        }
+
