index 0000000..9f9b0d7
--- /dev/null
+++ b/apps/medicine_buddy/tests/test_fetch_object.py
@@ -0,0 +1,73 @@
+"""fetch_object: confirm first, then ask the arm PC over arm.v1 /v1/fetch."""
+from __future__ import annotations
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from pathlib import Path
+
+from medicine_buddy.api import MedicineBuddyService
+from medicine_buddy.arm_protocol import FetchCommand, FetchResult
+from medicine_buddy.config import AppConfig
+
+
+def _arm(reply: dict):
+    seen: list[dict] = []
+
+    class H(BaseHTTPRequestHandler):
+        def do_POST(self):  # noqa: N802
+            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            seen.append({"path": self.path, **body})
+            data = json.dumps({**reply, "request_id": body["request_id"]}).encode()
+            self.send_response(200)
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def log_message(self, *a):  # noqa: D401
+            pass
+
+    srv = HTTPServer(("127.0.0.1", 0), H)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    return srv, f"http://127.0.0.1:{srv.server_address[1]}", seen
+
+
+def test_protocol_roundtrip() -> None:
+    cmd = FetchCommand(request_id="r", object_name="water bottle")
+    assert json.loads(cmd.to_json())["object"] == "water bottle"
+    res = FetchResult.from_dict({"ok": True, "final_state": "placed", "label": "water bottle"})
+    assert res.ok and res.final_state == "placed"
+    assert FetchResult.from_dict({"ok": False, "final_state": "weird"}).final_state == "failed"
+
+
+def test_fetch_asks_first_then_calls_arm(tmp_path: Path) -> None:
+    srv, url, seen = _arm({"ok": True, "final_state": "placed", "label": "water bottle"})
+    try:
+        service = MedicineBuddyService(tmp_path / "f.db", AppConfig(dry_run=False, arm_url=url))
+        first = service.fetch_object({"object": "water bottle", "confirmed": False})
+        assert first["status"] == "needs_confirm" and seen == []
+        done = service.fetch_object({"object": "water bottle", "confirmed": True})
+        assert done["status"] == "ok" and "ready" in done["speak_hint"]
+        assert seen[0]["path"] == "/v1/fetch" and seen[0]["object"] == "water bottle"
+        assert seen[0]["dry_run"] is False
+        service.close()
+    finally:
+        srv.shutdown()
+
+
+def test_fetch_failure_is_spoken(tmp_path: Path) -> None:
+    srv, url, _ = _arm({"ok": False, "final_state": "failed", "error": "object not found on the table"})
+    try:
+        service = MedicineBuddyService(tmp_path / "f.db", AppConfig(dry_run=False, arm_url=url))
+        service.fetch_object({"object": "water bottle", "confirmed": False})
+        r = service.fetch_object({"object": "water bottle", "confirmed": True})
+        assert r["status"] == "failed" and "not found" in r["speak_hint"]
+        service.close()
+    finally:
+        srv.shutdown()
+
+
+def test_no_arm_url_is_a_clear_error(tmp_path: Path) -> None:
+    service = MedicineBuddyService(tmp_path / "f.db", AppConfig(dry_run=False))
+    assert "arm computer" in service.fetch_object({"object": "water bottle", "confirmed": True})["speak_hint"]
+    service.close()
