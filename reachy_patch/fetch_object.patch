@@ -0,0 +1,53 @@
+"""External tool: ask the arm to bring a household object after the person confirms."""
+
+from __future__ import annotations
+
+import importlib.util
+import logging
+from pathlib import Path
+from typing import Any
+
+from reachy_mini_conversation_app.tools.core_tools import Tool, ToolDependencies
+
+logger = logging.getLogger(__name__)
+
+
+def _api_request(method: str, path: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
+    helper = Path(__file__).resolve().parent.parent / "lib" / "tool_http.py"
+    spec = importlib.util.spec_from_file_location("medicine_tool_http", helper)
+    if spec is None or spec.loader is None:
+        return {"error": f"missing helper {helper}"}
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod.api_request(method, path, body)
+
+
+class FetchObject(Tool):
+    name = "fetch_object"
+    description = (
+        "Ask the arm to bring an everyday object (for example the water bottle) to the person. "
+        "Ask first: 'Should I bring you the {object}?' and only call with confirmed=true after "
+        "they say yes. Use dispense_medicine for medicines, not this tool. Pass the object as the "
+        "person said it; the arm only knows a short fixed list and will say if it cannot find it."
+    )
+    parameters_schema = {
+        "type": "object",
+        "properties": {
+            "object": {"type": "string", "description": "Object to bring, e.g. 'water bottle'"},
+            "confirmed": {
+                "type": "boolean",
+                "description": "True only after the person agreed to bring it",
+            },
+        },
+        "required": ["object", "confirmed"],
+    }
+
+    async def __call__(self, deps: ToolDependencies, **kwargs: Any) -> dict[str, Any]:
+        del deps
+        payload = _api_request(
+            "POST",
+            "/arm/fetch",
+            {"object": kwargs.get("object"), "confirmed": bool(kwargs.get("confirmed", False))},
+        )
+        logger.info("fetch_object -> %s", payload)
+        return payload
